# Public OKX market data. Public candles do not require private OKX credentials.
OKX_BASE_URL=https://www.okx.com

# Frontend calls the local TradePlaybook API through this base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Server-side AI configuration. Never expose this key to the frontend.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
AI_API_KEY=your_server_side_key

# Reserved for future read-only private OKX use. Not needed for public candles.
OKX_API_KEY=your_server_side_key
OKX_SECRET_KEY=your_server_side_secret
OKX_PASSPHRASE=your_server_side_passphrase
